# Public site URL used for canonical metadata, OpenGraph, and sitemap.xml
NEXT_PUBLIC_SITE_URL=https://drishyasahayak.vercel.app

# Optional: Contact & Waitlist email delivery via Resend (https://resend.com)
# If configured, API routes send transactional notifications directly via Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Drishya Sahayak <onboarding@resend.dev>
CONTACT_TO_EMAIL=drishyasahayak@gmail.com

# Optional: Formspree endpoint URL fallback (https://formspree.io)
# Used if RESEND_API_KEY is not set. Leave empty for local development simulation.
FORMSPREE_CONTACT_ENDPOINT=
FORMSPREE_WAITLIST_ENDPOINT=
