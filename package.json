{
  "name": "drishya-sahayak-web",
  "version": "1.0.0",
  "private": true,
  "description": "Production marketing website and documentation for Drishya Sahayak V1 — an open-source AI desktop visual assistant.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
