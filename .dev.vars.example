# Cloudflare Worker Local Development Variables (.dev.vars)
# Copy this file to .dev.vars and fill in required values if testing live email delivery.

# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Resend API Key for contact form and waitlist emails
# Set with: npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY=re_example_1234567890

# Email configurations
RESEND_FROM_EMAIL=Drishya Sahayak <onboarding@resend.dev>
CONTACT_TO_EMAIL=dhyandevp@proton.me

# Optional: Formspree fallback endpoints
FORMSPREE_CONTACT_ENDPOINT=
FORMSPREE_WAITLIST_ENDPOINT=
